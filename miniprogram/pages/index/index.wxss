.page { padding-bottom: 220rpx; }
.header { background: #1f9d55; color: #fff; padding: 30rpx 30rpx 24rpx; }
.hello { font-size: 34rpx; font-weight: 600; }
.datebar { margin-top: 10rpx; font-size: 26rpx; opacity: 0.95; }
.date { color: #ffe89a; }
.cats { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 20rpx 24rpx; background: #fff; }
.cat { padding: 10rpx 26rpx; border-radius: 30rpx; background: #f1f3f2; font-size: 26rpx; color: #444; }
.cat.on { background: #1f9d55; color: #fff; }
.goods { padding: 20rpx 24rpx; }
.gcard { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.gname { font-size: 30rpx; font-weight: 600; }
.gunit { color: #999; font-size: 24rpx; font-weight: 400; }
.gsub { margin-top: 8rpx; display: flex; align-items: center; gap: 10rpx; }
.price { color: #e64340; font-size: 30rpx; font-weight: 700; }
.ptag { font-size: 20rpx; color: #b27b00; background: #fff4d6; border-radius: 6rpx; padding: 2rpx 8rpx; }
.spec { font-size: 20rpx; color: #999; }
.stepper { display: flex; align-items: center; gap: 16rpx; }
.step { width: 52rpx; height: 52rpx; border-radius: 50%; text-align: center; line-height: 48rpx; font-size: 34rpx; }
.minus { border: 1rpx solid #ccc; color: #666; }
.plus { background: #1f9d55; color: #fff; }
.qty { min-width: 40rpx; text-align: center; font-size: 30rpx; }
.qty-in { min-width: 70rpx; text-align: center; font-size: 30rpx; border: 1rpx solid #e2e2e2; border-radius: 10rpx; padding: 8rpx 4rpx; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }
.cartbar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; background: #fff; padding: 20rpx 30rpx; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); z-index: 10; }
.voicebar { position: fixed; left: 0; right: 0; bottom: 140rpx; display: flex; justify-content: center; z-index: 9; }
.voice-btn { background: #1f2d3d; color: #fff; font-size: 30rpx; padding: 20rpx 70rpx; border-radius: 44rpx; opacity: 0.92; }
.voice-btn.rec { background: #e64340; animation: pulse 1s infinite; }
@keyframes pulse { 50% { opacity: 0.6; } }
.sum { flex: 1; font-size: 28rpx; }
.money { color: #e64340; font-weight: 700; font-size: 34rpx; }
.submit { background: #1f9d55; color: #fff; font-size: 30rpx; padding: 18rpx 60rpx; border-radius: 44rpx; }
.submit.off { background: #c8c8c8; }

.result-mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 30; display: flex; align-items: center; justify-content: center; }
.result-card { width: 76%; background: #fff; border-radius: 20rpx; padding: 44rpx 36rpx 36rpx; text-align: center; }
.result-icon { font-size: 64rpx; }
.result-title { font-size: 34rpx; font-weight: 700; margin-top: 14rpx; }
.result-lines { font-size: 26rpx; color: #666; margin-top: 14rpx; line-height: 1.7; white-space: pre-line; }
.result-btn { margin: 34rpx auto 0; background: #1f9d55; color: #fff; font-size: 30rpx; padding: 18rpx 0; border-radius: 44rpx; width: 70%; }
