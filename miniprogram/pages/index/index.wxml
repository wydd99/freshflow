<view class="page">
  <view class="header">
    <view class="hello">{{ customerName || '加载中…' }}</view>
    <view class="datebar">
      <text>发货日期：</text>
      <picker mode="date" value="{{deliveryDate}}" bindchange="onDateChange">
        <text class="date">{{deliveryDate}} ▾</text>
      </picker>
    </view>
  </view>

  <view class="cats">
    <view class="cat {{catId === item.id ? 'on' : ''}}" wx:for="{{categories}}" wx:key="id"
      data-id="{{item.id}}" bindtap="onCat">{{item.name}}</view>
  </view>

  <view class="goods">
    <view class="gcard" wx:for="{{goods}}" wx:key="id">
      <view class="ginfo">
        <view class="gname" data-id="{{item.id}}" bindtap="showDetail">{{item.name}} <text class="gunit">/{{item.unit}}</text></view>
        <view class="gsub">
          <text class="price">¥{{item.salePrice}}</text>
          <text wx:if="{{item.spec}}" class="spec">{{item.spec}}</text>
        </view>
      </view>
      <view class="stepper">
        <view class="step minus" data-id="{{item.id}}" bindtap="onMinus">−</view>
        <input class="qty-in" type="digit" value="{{cart[item.id] || 0}}" data-id="{{item.id}}" bindblur="onQtyInput" />
        <view class="step plus" data-id="{{item.id}}" bindtap="onPlus">＋</view>
      </view>
    </view>
    <view wx:if="{{!goods.length}}" class="empty">该分类暂无可见商品</view>
  </view>

  <view class="result-mask" wx:if="{{result.visible}}">
    <view class="result-card">
      <view class="result-icon">{{result.ok ? '✅' : '⚠️'}}</view>
      <view class="result-title">{{result.ok ? '下单成功' : '下单失败'}}</view>
      <view class="result-lines" wx:if="{{result.ok}}">订单号 {{result.orderNo}}
配送站确认后会尽快安排发货</view>
      <view class="result-lines" wx:else>{{result.msg}}</view>
      <view class="result-btn" bindtap="closeResult">确认（{{result.countdown}}）</view>
    </view>
  </view>

  <view class="voicebar">
    <view class="voice-btn {{recording ? 'rec' : ''}}" bindtouchstart="onVoiceStart" bindtouchend="onVoiceEnd">
      {{recording ? '松开 · 识别中…' : '🎤 按住说话下单'}}
    </view>
  </view>

  <view class="cpanel-mask" wx:if="{{cartPanel}}" bindtap="closeCart">
    <view class="cpanel" catchtap="noop">
      <view class="cpanel-title">购物车（{{count}} 件 · ¥{{total}}）</view>
      <scroll-view scroll-y class="cpanel-list">
        <view wx:for="{{cartItems}}" wx:key="id" class="crow">
          <view class="cname">{{item.name}}<text class="cunit">¥{{item.price}}/{{item.unit}}</text></view>
          <view class="cctrl">
            <view class="cstep" data-id="{{item.id}}" bindtap="onMinus">−</view>
            <text class="cq">{{item.qty}}</text>
            <view class="cstep" data-id="{{item.id}}" bindtap="onPlus">＋</view>
            <text class="csub">¥{{item.sub}}</text>
            <text class="cdel" data-id="{{item.id}}" bindtap="onRemove">✕</text>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!cartItems.length}}" class="cpanel-empty">购物车是空的</view>
      <view class="cpanel-btns">
        <button class="cbtn" bindtap="onClearCart">清空</button>
        <button class="cbtn primary" bindtap="onSubmit">去下单</button>
      </view>
    </view>
  </view>

  <view class="cartbar">
    <view class="sum" bindtap="openCart">合计 <text class="money">¥{{total}}</text>（{{count}} 件）<text style="color:#1f9d55;font-size:22rpx"> · 查看 ▸</text></view>
    <view class="submit {{count ? '' : 'off'}}" bindtap="onSubmit">去下单</view>
  </view>
</view>
