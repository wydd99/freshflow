<view class="page">
  <view class="head">
    <view class="hello">老板日报</view>
    <view class="sub">鲜配 · 示例商家A</view>
  </view>

  <view class="cards">
    <view class="card"><view class="cl">今日订单</view><view class="cv">{{today.count}}</view></view>
    <view class="card"><view class="cl">今日销售额</view><view class="cv">¥{{today.sales}}</view></view>
    <view class="card"><view class="cl">待分拣</view><view class="cv orange">{{today.pendingSort}}</view></view>
    <view class="card"><view class="cl">客户欠款</view><view class="cv red">¥{{debts.total}}</view></view>
  </view>

  <view class="sec">近 7 日销售额</view>
  <view class="week">
    <view class="wrow" wx:for="{{week}}" wx:key="date">
      <text class="wdate">{{item.date.slice(5)}}</text>
      <view class="wbarbg"><view class="wbar" style="width: {{item.pct}}%"></view></view>
      <text class="wval">¥{{item.sales}}</text>
    </view>
  </view>

  <view class="sec">欠款客户 TOP5</view>
  <view class="debt" wx:for="{{debts.list}}" wx:key="customerId">
    <text>{{item.name}}</text><text class="dval">¥{{item.balance}}</text>
  </view>
  <view wx:if="{{!debts.list.length}}" class="empty">暂无欠款 ✅</view>

  <view class="foot" bindtap="doLogout">退出登录</view>
</view>
